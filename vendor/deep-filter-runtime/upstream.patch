+pub fn slice_as_arrayview<'a>(buffer: &'a [f32], shape: &[usize]) -> ArrayViewD<'a, f32> {
+    ArrayViewD::from_shape(shape, buffer).expect("Matching contiguous tensor shape")
+}
+pub fn mut_slice_as_arrayviewmut<'a>(buffer: &'a mut [f32], shape: &[usize]) -> ArrayViewMutD<'a, f32> {
+    ArrayViewMutD::from_shape(shape, buffer).expect("Matching contiguous tensor shape")
+}
+pub fn as_arrayview_complex<'a>(buffer: ArrayViewD<'a, f32>, shape: &[usize]) -> ArrayViewD<'a, Complex32> {
+    let values = buffer.to_slice().expect("Contiguous complex tensor");
+    ArrayViewD::from_shape(shape, bytemuck::cast_slice(values)).expect("Matching complex shape")
+}
+pub fn as_array_mut_complex<'a>(buffer: ArrayViewMutD<'a, f32>, shape: &[usize]) -> ArrayViewMutD<'a, Complex32> {
+    let values = buffer.into_slice().expect("Contiguous complex tensor");
+    ArrayViewMutD::from_shape(shape, bytemuck::cast_slice_mut(values)).expect("Matching complex shape")
+}
