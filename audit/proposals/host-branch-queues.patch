+//! Proposed host regression: install as host/tests/branch_queue_regression.rs.
+//! It fails on the current common-prefix merge because the fast branch's
+//! unmatched samples are discarded between calls.
+use super::super::{daw_host::DawHost, graph_edge::GraphEdge};
+use crate::parameters::{Parameter, ParameterId, ParameterValue};
+use crate::plugin::{Plugin, PluginInfo, ProcessContext};
+
+struct Burst {
+    first: bool,
+    delayed: bool,
+    held: [f32; 2],
+    pending: bool,
+}
+impl Plugin for Burst {
+    fn info(&self) -> PluginInfo {
+        PluginInfo::new("burst fixture", "1", "test")
+    }
+    fn input_channels(&self) -> usize {
+        1
+    }
+    fn output_channels(&self) -> usize {
+        1
+    }
+    fn parameters(&self) -> Vec<Parameter> {
+        vec![]
+    }
+    fn set_parameter(&mut self, _: ParameterId, _: ParameterValue) -> Result<(), String> {
+        Ok(())
+    }
+    fn get_parameter(&self, _: &ParameterId) -> Option<ParameterValue> {
+        None
+    }
+    fn output_frames_for_input(&self, frames: usize) -> usize {
+        if self.delayed { frames + 2 } else { frames }
+    }
+    fn process(
+        &mut self,
+        input: &[f32],
+        output: &mut [f32],
+        context: &ProcessContext,
+    ) -> Result<usize, String> {
+        if !self.delayed {
+            output[..input.len()].copy_from_slice(input);
+            return Ok(context.num_frames);
+        }
+        if self.first {
+            self.first = false;
+            self.pending = true;
+            self.held.copy_from_slice(&input[2..4]);
+            output[..2].copy_from_slice(&input[..2]);
+            Ok(2)
+        } else if self.pending {
+            self.pending = false;
+            output[..2].copy_from_slice(&self.held);
+            output[2..2 + input.len()].copy_from_slice(input);
+            Ok(input.len() + 2)
+        } else {
+            output[..input.len()].copy_from_slice(input);
+            Ok(input.len())
+        }
+    }
+}
+
+#[test]
+fn unmatched_branch_suffix_survives_next_callback() {
+    let mut host = DawHost::new(1, 48000);
+    let fast = host
+        .add_node(
+            "fast".into(),
+            Box::new(Burst {
+                first: true,
+                delayed: false,
+                held: [0.0; 2],
+                pending: false,
+            }),
+        )
+        .unwrap();
+    let slow = host
+        .add_node(
+            "burst".into(),
+            Box::new(Burst {
+                first: true,
+                delayed: true,
+                held: [0.0; 2],
+                pending: false,
+            }),
+        )
+        .unwrap();
+    let join = host
+        .add_node(
+            "join".into(),
+            Box::new(Burst {
+                first: true,
+                delayed: false,
+                held: [0.0; 2],
+                pending: false,
+            }),
+        )
+        .unwrap();
+    host.add_edge(GraphEdge::new(fast, join)).unwrap();
+    host.add_edge(GraphEdge::new(slow, join)).unwrap();
+    host.build().unwrap();
+    let mut output = [0.0; 6];
+    assert_eq!(host.process(&[0.0, 1.0, 2.0, 3.0], &mut output).unwrap(), 2);
+    assert_eq!(&output[..2], &[0.0, 2.0]);
+    let frames = host.process(&[4.0, 5.0, 6.0, 7.0], &mut output).unwrap();
+    assert_eq!(
+        frames, 6,
+        "two queued frames plus four new frames must reach the join"
+    );
+    assert_eq!(output, [4.0, 6.0, 8.0, 10.0, 12.0, 14.0]);
+    let frames = host.process(&[8.0, 9.0, 10.0, 11.0], &mut output).unwrap();
+    assert_eq!(frames, 4);
+    assert_eq!(&output[..frames], &[16.0, 18.0, 20.0, 22.0]);
+    assert!(
+        host.drain(&mut output)
+            .unwrap_err()
+            .contains("requires a linear plugin graph")
+    );
+}
