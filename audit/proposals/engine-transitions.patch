+//! Ordered output barriers. A failed transaction stays held until engine rebuild.
+
+use crate::engine::{PlaybackConfiguration, PlaybackThread, PlaybackTransitionOperation,
+    ProcessingCommand, ProcessingHoldInput, ProcessingResponse, ProcessingThread};
+use std::time::{Duration, Instant};
+
+pub(super) fn wait_response(processing: &ProcessingThread, request: u64) -> Result<ProcessingResponse, String> {
+    let deadline = Instant::now() + Duration::from_secs(5);
+    let mut claimed = false;
+    loop {
+        if let Some(response) = processing.try_recv_response_for(request) {
+            return match response { ProcessingResponse::Error(error) => Err(error), response => Ok(response) };
+        }
+        if !claimed && Instant::now() >= deadline {
+            if processing.cancel_request(request) {
+                processing.abandon_request(request);
+                return Err("output transition timed out before processing claimed it".into());
+            }
+            claimed = true;
+        }
+        if processing.is_finished() { return Err("processing worker exited during output transition".into()); }
+        std::thread::sleep(Duration::from_millis(1));
+    }
+}
+
+/// Establish acceptance hold before any upstream wait that can encounter a
+/// full data queue. Playback keeps recycling while held, releasing backpressure.
+pub(super) fn hold_playback(processing: &mut ProcessingThread, playback: &PlaybackThread) -> Result<(u64, bool), String> {
+    let (id, previously_stopped) = match processing.output_transition {
+        Some((id, true)) => (id, true),
+        Some((_, false)) => return Err("output transition failed; rebuild the engine before restarting".into()),
+        None => {
+            let id = processing.next_output_transition;
+            processing.next_output_transition = id.checked_add(1).ok_or("output transition IDs exhausted")?;
+            (id, false)
+        }
+    };
+    processing.output_transition = Some((id, false));
+    playback.transition(id, PlaybackTransitionOperation::Hold)?;
+    Ok((id, previously_stopped))
+}
+
+pub(super) fn hold_processing(processing: &ProcessingThread, id: u64, input: ProcessingHoldInput) -> Result<(PlaybackConfiguration, usize), String> {
+    let request = processing.send_command(ProcessingCommand::HoldOutput { transition_id: id, input })?;
+    match wait_response(processing, request)? {
+        ProcessingResponse::OutputHeld { transition_id, output_channels, output_sample_rate, latency_samples } if transition_id == id =>
+            Ok((PlaybackConfiguration { sample_rate: output_sample_rate, channels: output_channels }, latency_samples)),
+        _ => Err("processing replied with an unexpected output hold acknowledgement".into()),
+    }
+}
+
+pub(super) fn configure(playback: &PlaybackThread, id: u64, source: PlaybackConfiguration, channel_limit: usize, discard_stream: bool) -> Result<PlaybackConfiguration, String> {
+    let hardware = PlaybackConfiguration {
+        sample_rate: source.sample_rate,
+        channels: if channel_limit == 0 { source.channels } else { source.channels.min(channel_limit) },
+    };
+    playback.transition(id, PlaybackTransitionOperation::Configure { source, hardware, discard_stream })
+}
+
+pub(super) fn release(processing: &mut ProcessingThread, playback: &PlaybackThread, id: u64) -> Result<(), String> {
+    playback.transition(id, PlaybackTransitionOperation::Release)?;
+    let request = processing.send_command(ProcessingCommand::ReleaseOutput { transition_id: id })?;
+    match wait_response(processing, request)? {
+        ProcessingResponse::OutputReleased { transition_id } if transition_id == id => { processing.output_transition = None; Ok(()) }
+        _ => Err("processing replied with an unexpected output release acknowledgement".into()),
+    }
+}
+
+/// Successful Stop has already emptied input/output queues and configured the
+/// device. Its initial Play Flush fits while processing remains held.
+pub(super) fn restart_stopped(processing: &mut ProcessingThread, playback: &PlaybackThread) -> Result<(), String> {
+    match processing.output_transition {
+        Some((id, true)) => {
+            // Clear pause while acceptance is still held. The following
+            // acknowledged Release is ordered after Resume on the same FIFO.
+            playback.send_command(crate::engine::PlaybackCommand::Resume)?;
+            release(processing, playback, id)
+        },
+        Some((_, false)) => Err("output transition failed; rebuild the engine before restarting".into()),
+        None => Ok(()),
+    }
+}
+
+pub(super) fn ensure_restartable(processing: &ProcessingThread) -> Result<(), String> {
+    if matches!(processing.output_transition, Some((_, false))) {
+        Err("output transition failed; rebuild the engine before restarting".into())
+    } else { Ok(()) }
+}
