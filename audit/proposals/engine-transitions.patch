+/// Pauses at the exact call site that owns an unsent frame or stream marker.
+/// Retained EOS/Flush remain on that stack until release, so an interrupted
+/// drain cannot lose the only terminal marker for a finite stream.
+struct PublicationBoundary<'a> {
+    decoder_rx: &'a Receiver<DecoderMessage>,
+    decoder_recycle_tx: &'a SyncSender<Vec<f32>>,
+    command_rx: &'a Receiver<ProcessingRequest>,
+    response_tx: &'a Sender<ProcessingReply>,
+    event_tx: &'a crossbeam::channel::Sender<ThreadEvent>,
+}
+
+impl PublicationBoundary<'_> {
+    fn handle(&self, mut request: ProcessingRequest, state: &mut ProcessingState) -> CommandOutcome {
+        let mut held = None;
+        let mut discarded = false;
+        loop {
+            let response = CorrelatedResponseSender { request_id: request.id, inner: self.response_tx };
+            match request.command {
+                ProcessingCommand::HoldOutput { transition_id, input } => {
+                    if !request.ticket.try_claim() {
+                        response.send(ProcessingResponse::Error("output hold was cancelled".into())).ok();
+                    } else if held.is_some_and(|active| active != transition_id)
+                        || (held.is_none() && transition_id <= state.last_output_transition)
+                    {
+                        response.send(ProcessingResponse::Error("stale or conflicting output hold".into())).ok();
+                    } else {
+                        held = Some(transition_id);
+                        state.last_output_transition = transition_id;
+                        if input == super::super::ProcessingHoldInput::DiscardQuiescedStream {
+                            while let Ok(message) = self.decoder_rx.try_recv() {
+                                if let DecoderMessage::Frame(frame) = message
+                                    && let Err(error) = self.decoder_recycle_tx.try_send(frame.data)
+                                {
+                                    let (std::sync::mpsc::TrySendError::Full(data)
+                                        | std::sync::mpsc::TrySendError::Disconnected(data)) = error;
+                                    state.retire(GcItem::Buffer(data));
+                                }
+                            }
+                            state.reset();
+                            discarded = true;
+                        }
+                        response.send(ProcessingResponse::OutputHeld {
+                            transition_id,
+                            output_channels: state.output_channels(),
+                            output_sample_rate: state.output_sample_rate(state.sample_rate),
+                            latency_samples: if state.bypassed { 0 } else { state.host.total_latency_samples() },
+                        }).ok();
+                    }
+                }
+                ProcessingCommand::ReleaseOutput { transition_id } => {
+                    if !request.ticket.try_claim() {
+                        response.send(ProcessingResponse::Error("output release was cancelled".into())).ok();
+                    } else if held != Some(transition_id) {
+                        response.send(ProcessingResponse::Error("output release does not match active hold".into())).ok();
+                    } else {
+                        response.send(ProcessingResponse::OutputReleased { transition_id }).ok();
+                        return if discarded { CommandOutcome::Stopped } else { CommandOutcome::Continue };
+                    }
+                }
+                _ => {
+                    let outcome = handle_processing_command(request, state, self.response_tx, self.event_tx);
+                    if held.is_none() || outcome == CommandOutcome::Shutdown {
+                        return outcome;
+                    }
+                    discarded |= outcome == CommandOutcome::Stopped;
+                }
+            }
+            if held.is_none() {
+                return CommandOutcome::Continue;
+            }
+            // No audio publication or decoder consumption while held. Shutdown,
+            // host commits, and matching releases remain command-responsive.
+            request = match self.command_rx.recv() {
+                Ok(request) => request,
+                Err(_) => return CommandOutcome::Shutdown,
+            };
+        }
     }
 }
 
