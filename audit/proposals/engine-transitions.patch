+//! Allocation-free output acceptance shared by desktop and RemoteIO workers.
+
+use super::{AudioFrame, PlaybackConfiguration};
+
+pub(super) struct PlaybackAcceptance {
+    source: PlaybackConfiguration,
+    held: Option<u64>,
+    last_transition: u64,
+    configured: bool,
+}
+
+impl PlaybackAcceptance {
+    pub(super) fn new(source: PlaybackConfiguration) -> Self {
+        Self { source, held: None, last_transition: 0, configured: true }
+    }
+
+    pub(super) fn hold(&mut self, id: u64) -> Result<(), &'static str> {
+        if self.held == Some(id) { return Ok(()); }
+        if self.held.is_some() || id <= self.last_transition {
+            return Err("stale or conflicting playback output hold");
+        }
+        self.held = Some(id);
+        self.last_transition = id;
+        self.configured = false;
+        Ok(())
+    }
+
+    pub(super) fn validate(&self, id: u64) -> Result<(), &'static str> {
+        if self.held == Some(id) { Ok(()) }
+        else { Err("playback transition does not match active hold") }
+    }
+
+    pub(super) fn begin_configuration(&mut self, id: u64) -> Result<(), &'static str> {
+        self.validate(id)?;
+        self.configured = false;
+        Ok(())
+    }
+
+    /// Called only after queue/callback flush and hardware configuration succeed.
+    pub(super) fn configured(&mut self, id: u64, source: PlaybackConfiguration) -> Result<(), &'static str> {
+        self.validate(id)?;
+        if source.sample_rate == 0 || source.channels == 0 {
+            return Err("playback source format must have a nonzero rate and channel count");
+        }
+        self.source = source;
+        self.configured = true;
+        Ok(())
+    }
+
+    pub(super) fn release(&mut self, id: u64) -> Result<(), &'static str> {
+        self.validate(id)?;
+        if !self.configured { return Err("playback output was not configured while held"); }
+        self.held = None;
+        Ok(())
+    }
+
+    pub(super) fn is_held(&self) -> bool { self.held.is_some() }
+
+    pub(super) fn accepts(&self, frame: &AudioFrame) -> bool {
+        !self.is_held() && frame.sample_rate == self.source.sample_rate
+            && frame.num_channels == self.source.channels
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn stale_release_and_failed_configuration_keep_output_held() {
+        let format = PlaybackConfiguration { sample_rate: 48_000, channels: 6 };
+        let mut acceptance = PlaybackAcceptance::new(format);
+        let frame = AudioFrame::new(vec![0.5; 6], 1, 6, 48_000);
+        assert!(acceptance.accepts(&frame));
+        acceptance.hold(4).unwrap();
+        assert!(acceptance.release(4).is_err());
+        assert!(acceptance.configured(3, format).is_err());
+        assert!(acceptance.hold(5).is_err());
+        assert!(!acceptance.accepts(&frame));
+        acceptance.configured(4, format).unwrap();
+        assert!(acceptance.release(3).is_err());
+        acceptance.release(4).unwrap();
+        assert!(acceptance.accepts(&frame));
+        assert!(acceptance.hold(4).is_err());
+        acceptance.hold(5).unwrap();
+        assert!(acceptance.release(4).is_err());
+    }
+
+    #[test]
+    fn acceptance_checks_source_clock_and_width_independent_of_hardware_routing() {
+        let mut acceptance = PlaybackAcceptance::new(PlaybackConfiguration { sample_rate: 48_000, channels: 6 });
+        acceptance.hold(1).unwrap();
+        acceptance.configured(1, PlaybackConfiguration { sample_rate: 96_000, channels: 4 }).unwrap();
+        acceptance.release(1).unwrap();
+        assert!(acceptance.accepts(&AudioFrame::new(vec![1.0; 4], 1, 4, 96_000)));
+        assert!(!acceptance.accepts(&AudioFrame::new(vec![1.0; 4], 1, 4, 48_000)));
+        assert!(!acceptance.accepts(&AudioFrame::new(vec![1.0; 2], 1, 2, 96_000)));
+    }
+}
