+#[test]
+fn bypass_reports_the_new_clock_before_held_audio_is_released() {
+    let worker = Worker::new();
+    worker.hold(1, ProcessingHoldInput::RetainInput);
+    let accepted_rate = worker.acknowledge_bypass(true);
+    assert_eq!(accepted_rate, 48_000);
+    worker.send_frame(0.75);
+    assert!(worker.output_rx.as_ref().unwrap().try_recv().is_err());
+    worker.release(1);
+    let frame = worker.frame();
+    assert_eq!(frame.sample_rate, accepted_rate);
+    assert_eq!(frame.num_frames, 1);
+    assert_eq!(frame.data, [0.75]);
+    worker.hold(2, ProcessingHoldInput::RetainInput);
+    assert_eq!(worker.acknowledge_bypass(false), 96_000);
+    worker.release(2);
+    worker.send_frame(0.9);
+    assert_eq!(worker.frame().data, [0.9, 0.9]);
+}
