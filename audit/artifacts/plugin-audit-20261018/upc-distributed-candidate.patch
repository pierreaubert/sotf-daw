+            }
+        } else {
+            let offset = (fdl_partition * self.channels + output_ch) * FFT_BINS;
+            let ir_ch = output_ch % state.ir_channels;
+            complex_mul_add_simd(
+                &mut self.fft_sum,
+                &self.ir_runtime.fdl_flat[offset..offset + FFT_BINS],
+                &state.partitions[ir_ch][partition],
+            );
+        }
+    }
