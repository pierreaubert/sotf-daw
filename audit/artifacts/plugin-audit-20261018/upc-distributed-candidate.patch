+        let inv_n = 1.0 / FFT_SIZE as f32;
+        for i in 0..FFT_SIZE {
+            self.output_accum[output_ch][i] += self.fft_time[i] * inv_n;
+        }
+        self.fft_sum.fill(Complex::new(0.0, 0.0));
+    }
