+    fn add_upc_sum_to_overlap(&mut self, state: &ConvolutionState, output_ch: usize) {
+        // DC and Nyquist are real in the implicit Hermitian spectrum.
+        self.fft_sum[0].im = 0.0;
+        self.fft_sum[FFT_BINS - 1].im = 0.0;
