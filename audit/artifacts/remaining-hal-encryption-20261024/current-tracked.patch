+    /// Publish a fresh mapping without resizing or resetting a live peer's mapping.
+    ///
+    /// The old inode remains valid for pinned readers until the HAL control
+    /// thread observes replacement and hands off. A peer that died holding a
+    /// control/IO gate cannot poison the new daemon session. User volume is
+    /// carried over as one atomic tuple; transport readiness is freshly earned.
+    pub fn create_replacement_with_max_geometry<P: AsRef<Path>>(
+        path: P,
+        sample_rate: u32,
+        buffer_frames: u32,
+        channel_count: u32,
+        max_buffer_frames: u32,
+        max_channel_count: u32,
+    ) -> io::Result<Self> {
+        use std::io::Write;
+        use std::os::unix::fs::OpenOptionsExt;
+
+        let path = path.as_ref();
+        let parent = path.parent().ok_or_else(|| {
+            io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "mapping requires a parent directory",
+            )
+        })?;
+        ensure_secure_parent_dir(parent)?;
+        let (audio_offset, _, _) = Self::audio_layout(buffer_frames, channel_count, sample_rate)?;
+        let (_, max_audio_capacity, length) = Self::audio_layout(
+            max_buffer_frames.max(buffer_frames),
+            max_channel_count.max(channel_count),
+            super::consts::MAX_HAL_SAMPLE_RATE,
+        )?;
+        let previous_volume = Self::open(path)
+            .ok()
+            .map(|old| old.header().volume_state.load(Ordering::Acquire))
+            .filter(|state| state >> 33 != 0);
+        let region = backing::create_region(length)?;
+        let record = Rendezvous::new(length)?;
+        let staging = parent.join(format!(".map-{:016x}", rand::random::<u64>()));
+        let result = (|| {
+            let mut marker = std::fs::OpenOptions::new()
+                .read(true)
+                .write(true)
+                .create_new(true)
+                .mode(0o600)
+                .custom_flags(libc::O_NOFOLLOW)
+                .open(&staging)?;
+            marker.write_all(&record.encode())?;
+            grant_coreaudiod_shared_memory_access(&staging)?;
+            let metadata = marker.metadata()?;
+            let server = DescriptorServer::start(path, region.try_clone()?, record)?;
+            // SAFETY: create_region validated an allocated Darwin shm extent.
+            // Its size cannot change, and the unpublished object has no audio
+            // participants until the fully initialized rendezvous is renamed.
+            let mmap = unsafe { memmap2::MmapOptions::new().len(length).map_mut(&region)? };
+            let mut replacement = Self {
+                mmap,
+                path: path.to_path_buf(),
+                backing_device: metadata.dev(),
+                backing_inode: metadata.ino(),
+                backing_length: metadata.len(),
+                descriptor_server: Some(server),
+                audio_offset,
+                max_audio_capacity,
+            };
+            replacement.initialize_header(sample_rate, buffer_frames, channel_count)?;
+            // A surviving HAL process restores its cached controls before
+            // publishing driver readiness when the former broker has exited.
+            replacement.header().volume_state.store(
+                previous_volume.unwrap_or(u64::from(1.0f32.to_bits())),
+                Ordering::Release,
+            );
+            std::fs::rename(&staging, path)?;
+            Ok(replacement)
+        })();
+        if result.is_err() {
+            let _ = std::fs::remove_file(&staging);
+        }
+        result
+    }
