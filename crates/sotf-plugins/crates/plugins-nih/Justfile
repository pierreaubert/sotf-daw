# ----------------------------------------------------------------------
# plugins-nih: VST3/CLAP wrappers via nih-plug
# ----------------------------------------------------------------------
# One crate, feature-gated plugins. Build each with --features <name>.

# All plugin features
NIH_FEATURES := "eq compressor limiter gate gain delay expander crossfeed saturation denoiser speech-denoiser hiss-reducer declick downmix mono-to-stereo stereo-imager transient-shaper de-esser dynamic-eq multiband-compressor multiband-expander convolution fletcher-munson loudness-compensation channel-mute-solo upmixer aae xtc binaural matrix pnd ab-compare crossover band-split band-merge aec beamformer linear-phase-eq spectral-compressor loudness-monitor spectrum-analyzer ambisonics dither"

_lib_name := "libplugins_nih"

[group('lint')]
lint-nih:
	{{cargo}} check -p plugins-nih --features eq
	{{cargo}} clippy -p plugins-nih --features eq

[group('lint')]
lint-nih-all:
	#!/usr/bin/env bash
	set -euo pipefail
	for feat in {{NIH_FEATURES}}; do
		echo "Checking $feat..."
		{{cargo}} check -p plugins-nih --features "$feat" --no-default-features
	done

# Build all feature-gated plugin cdylibs (release)
[group('build')]
build-nih-all:
	#!/usr/bin/env bash
	set -uo pipefail
	# Find workspace root
	ROOT=$({{cargo}} metadata --no-deps --format-version=1 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin)['workspace_root'])" 2>/dev/null || echo "$(pwd)/../../../..")
	mkdir -p dist/nih
	mkdir -p dist/nih/build-logs
	failed=0
	for feat in {{NIH_FEATURES}}; do
		echo "Building $feat..."
		lib_name="sotf_${feat//-/_}"
		dylib="$ROOT/target/release/{{_lib_name}}.dylib"
		staged="dist/nih/lib${lib_name}.dylib"
		log="dist/nih/build-logs/$feat.log"
		if ! rm -f "$dylib" "$staged"; then
			echo "  FAILED: $feat (could not remove stale output)" >&2
			failed=$((failed + 1))
			continue
		fi
		if {{cargo}} build --release --locked -p plugins-nih --features "$feat" --no-default-features >"$log" 2>&1 && [ -f "$dylib" ] && cp "$dylib" "$staged"; then
			echo "  built $staged"
		else
			echo "  FAILED: $feat (full log: $log)"
			tail -n 80 "$log"
			failed=$((failed + 1))
		fi
	done
	count=$(ls dist/nih/*.dylib 2>/dev/null | wc -l | tr -d ' ')
	total=$(echo "{{NIH_FEATURES}}" | wc -w | tr -d ' ')
	echo "Built $count/$total plugins in dist/nih/ ($failed failed)"
	[ "$failed" -eq 0 ]

# Build + bundle all VST3 plugins
[group('build')]
prod-vst3: build-nih-all
	#!/usr/bin/env bash
	set -euo pipefail
	VST3_DIR="dist/vst3"
	rm -rf "$VST3_DIR"
	for dylib in dist/nih/lib*.dylib; do
		base=$(basename "$dylib" .dylib | sed 's/^lib//')
		display=$(echo "$base" | sed 's/sotf_/SOTF /; s/_/ /g' | sed 's/\b\(.\)/\u\1/g')
		bundle="$VST3_DIR/${display}.vst3"
		mkdir -p "$bundle/Contents/MacOS"
		cp "$dylib" "$bundle/Contents/MacOS/${base}"
		printf '<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n<plist version="1.0">\n<dict>\n\t<key>CFBundleExecutable</key>\n\t<string>%s</string>\n\t<key>CFBundleIdentifier</key>\n\t<string>org.spinorama.sotf.%s.vst3</string>\n\t<key>CFBundleName</key>\n\t<string>%s</string>\n\t<key>CFBundlePackageType</key>\n\t<string>BNDL</string>\n\t<key>CFBundleVersion</key>\n\t<string>1</string>\n</dict>\n</plist>\n' "$base" "$base" "$display" > "$bundle/Contents/Info.plist"
	done
	echo "Bundled $(ls -d "$VST3_DIR"/*.vst3 | wc -l | tr -d ' ') VST3 plugins"

# Build + bundle all CLAP plugins
[group('build')]
prod-clap: build-nih-all
	#!/usr/bin/env bash
	set -euo pipefail
	CLAP_DIR="dist/clap"
	rm -rf "$CLAP_DIR"
	mkdir -p "$CLAP_DIR"
	for dylib in dist/nih/lib*.dylib; do
		base=$(basename "$dylib" .dylib | sed 's/^lib//')
		cp "$dylib" "$CLAP_DIR/${base}.clap"
	done
	echo "Bundled $(ls "$CLAP_DIR"/*.clap | wc -l | tr -d ' ') CLAP plugins"

# Install VST3 plugins
[group('install')]
install-vst3: prod-vst3
	#!/usr/bin/env bash
	set -euo pipefail
	DEST="$HOME/Library/Audio/Plug-Ins/VST3"
	mkdir -p "$DEST"
	for bundle in dist/vst3/*.vst3; do
		name=$(basename "$bundle")
		rm -rf "$DEST/$name"
		cp -R "$bundle" "$DEST/$name"
	done
	echo "Installed $(ls -d "$DEST"/SOTF*.vst3 2>/dev/null | wc -l | tr -d ' ') VST3 plugins to $DEST"

# Install CLAP plugins
[group('install')]
install-clap: prod-clap
	#!/usr/bin/env bash
	set -euo pipefail
	DEST="$HOME/Library/Audio/Plug-Ins/CLAP"
	mkdir -p "$DEST"
	cp dist/clap/*.clap "$DEST/"
	echo "Installed $(ls "$DEST"/sotf_*.clap 2>/dev/null | wc -l | tr -d ' ') CLAP plugins to $DEST"

# Build + install everything
[group('install')]
install-nih-all: install-vst3 install-clap

# ----------------------------------------------------------------------
# Linux builds (native .so)
# ----------------------------------------------------------------------
# NOTE: the recipes above are macOS-only (.dylib). The ones below cover
# Linux and Windows; outputs go to suffixed dist/ dirs so platforms never
# clobber each other.

# Build all feature-gated plugin cdylibs for native Linux (release)
[group('build')]
build-nih-linux:
	#!/usr/bin/env bash
	set -uo pipefail
	# Find workspace root
	ROOT=$({{cargo}} metadata --no-deps --format-version=1 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin)['workspace_root'])" 2>/dev/null || echo "$(pwd)/../../../..")
	mkdir -p dist/nih-linux
	mkdir -p dist/nih-linux/build-logs
	failed=0
	for feat in {{NIH_FEATURES}}; do
		echo "Building $feat..."
		lib_name="sotf_${feat//-/_}"
		built="$ROOT/target/release/{{_lib_name}}.so"
		staged="dist/nih-linux/lib${lib_name}.so"
		log="dist/nih-linux/build-logs/$feat.log"
		if ! rm -f "$built" "$staged"; then
			echo "  FAILED: $feat (could not remove stale output)" >&2
			failed=$((failed + 1))
			continue
		fi
		if {{cargo}} build --release --locked -p plugins-nih --features "$feat" --no-default-features >"$log" 2>&1 && [ -f "$built" ] && cp "$built" "$staged"; then
			echo "  built $staged"
		else
			echo "  FAILED: $feat (full log: $log)"
			tail -n 80 "$log"
			failed=$((failed + 1))
		fi
	done
	count=$(ls dist/nih-linux/*.so 2>/dev/null | wc -l | tr -d ' ')
	total=$(echo "{{NIH_FEATURES}}" | wc -w | tr -d ' ')
	echo "Built $count/$total plugins in dist/nih-linux/ ($failed failed)"
	[ "$failed" -eq 0 ]

# Build + bundle all VST3 plugins for Linux (x86_64-linux layout)
[group('build')]
prod-vst3-linux: build-nih-linux _package-vst3-linux

_package-vst3-linux:
	#!/usr/bin/env bash
	set -euo pipefail
	VST3_DIR="dist/vst3-linux"
	rm -rf "$VST3_DIR"
	for lib in dist/nih-linux/lib*.so; do
		base=$(basename "$lib" .so | sed 's/^lib//')
		display=$(echo "$base" | sed 's/sotf_/SOTF /; s/_/ /g' | sed 's/\b\(.\)/\u\1/g')
		bundle="$VST3_DIR/${display}.vst3"
		mkdir -p "$bundle/Contents/x86_64-linux"
		cp "$lib" "$bundle/Contents/x86_64-linux/${base}.so"
	done
	echo "Bundled $(ls -d "$VST3_DIR"/*.vst3 | wc -l | tr -d ' ') VST3 plugins"

# Build + bundle all CLAP plugins for Linux
[group('build')]
prod-clap-linux: build-nih-linux _package-clap-linux

_package-clap-linux:
	#!/usr/bin/env bash
	set -euo pipefail
	CLAP_DIR="dist/clap-linux"
	rm -rf "$CLAP_DIR"
	mkdir -p "$CLAP_DIR"
	for lib in dist/nih-linux/lib*.so; do
		base=$(basename "$lib" .so | sed 's/^lib//')
		cp "$lib" "$CLAP_DIR/${base}.clap"
	done
	echo "Bundled $(ls "$CLAP_DIR"/*.clap | wc -l | tr -d ' ') CLAP plugins"

# Build each feature once, then package the same dual-format cdylib for both hosts.
[group('build')]
prod-plugin-formats-linux: build-nih-linux _package-vst3-linux _package-clap-linux

# Install VST3 plugins on Linux (~/.vst3)
[group('install')]
install-vst3-linux: prod-vst3-linux
	#!/usr/bin/env bash
	set -euo pipefail
	DEST="$HOME/.vst3"
	mkdir -p "$DEST"
	for bundle in dist/vst3-linux/*.vst3; do
		name=$(basename "$bundle")
		rm -rf "$DEST/$name"
		cp -R "$bundle" "$DEST/$name"
	done
	echo "Installed $(ls -d "$DEST"/SOTF*.vst3 2>/dev/null | wc -l | tr -d ' ') VST3 plugins to $DEST"

# Install CLAP plugins on Linux (~/.clap)
[group('install')]
install-clap-linux: prod-clap-linux
	#!/usr/bin/env bash
	set -euo pipefail
	DEST="$HOME/.clap"
	mkdir -p "$DEST"
	cp dist/clap-linux/*.clap "$DEST/"
	echo "Installed $(ls "$DEST"/sotf_*.clap 2>/dev/null | wc -l | tr -d ' ') CLAP plugins to $DEST"

# Build + install everything on Linux
[group('install')]
install-nih-linux: install-vst3-linux install-clap-linux

# ----------------------------------------------------------------------
# Windows builds (cross via x86_64-pc-windows-gnu, or native MSVC)
# ----------------------------------------------------------------------
# Prerequisites for cross-building from Linux/macOS:
#   rustup target add x86_64-pc-windows-gnu
#   apt install mingw-w64   (provides x86_64-w64-mingw32-gcc)
# Override the triple on a native Windows host, e.g.:
#   just WIN_TARGET=x86_64-pc-windows-msvc build-nih-windows
WIN_TARGET := "x86_64-pc-windows-gnu"

# Build all feature-gated plugin cdylibs for Windows (release)
[group('build')]
build-nih-windows:
	#!/usr/bin/env bash
	set -uo pipefail
	if [ "{{WIN_TARGET}}" = "x86_64-pc-windows-gnu" ] && ! command -v x86_64-w64-mingw32-gcc >/dev/null 2>&1; then
		echo "Missing x86_64-w64-mingw32-gcc (package mingw-w64)." >&2
		echo "Install it, or run on a Windows host with:" >&2
		echo "  just WIN_TARGET=x86_64-pc-windows-msvc build-nih-windows" >&2
		exit 1
	fi
	# Find workspace root
	ROOT=$({{cargo}} metadata --no-deps --format-version=1 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin)['workspace_root'])" 2>/dev/null || echo "$(pwd)/../../../..")
	mkdir -p dist/nih-windows
	mkdir -p dist/nih-windows/build-logs
	failed=0
	for feat in {{NIH_FEATURES}}; do
		echo "Building $feat..."
		lib_name="sotf_${feat//-/_}"
		built="$ROOT/target/{{WIN_TARGET}}/release/plugins_nih.dll"
		staged="dist/nih-windows/${lib_name}.dll"
		log="dist/nih-windows/build-logs/$feat.log"
		if ! rm -f "$built" "$staged"; then
			echo "  FAILED: $feat (could not remove stale output)" >&2
			failed=$((failed + 1))
			continue
		fi
		if CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER=x86_64-w64-mingw32-gcc {{cargo}} build --release --locked --target "{{WIN_TARGET}}" -p plugins-nih --features "$feat" --no-default-features >"$log" 2>&1 && [ -f "$built" ] && cp "$built" "$staged"; then
			echo "  built $staged"
		else
			echo "  FAILED: $feat (full log: $log)"
			tail -n 80 "$log"
			failed=$((failed + 1))
		fi
	done
	count=$(ls dist/nih-windows/*.dll 2>/dev/null | wc -l | tr -d ' ')
	total=$(echo "{{NIH_FEATURES}}" | wc -w | tr -d ' ')
	echo "Built $count/$total plugins in dist/nih-windows/ ($failed failed)"
	[ "$failed" -eq 0 ]

# Build + bundle all VST3 plugins for Windows (x86_64-win layout)
[group('build')]
prod-vst3-windows: build-nih-windows
	#!/usr/bin/env bash
	set -euo pipefail
	VST3_DIR="dist/vst3-windows"
	rm -rf "$VST3_DIR"
	for lib in dist/nih-windows/*.dll; do
		base=$(basename "$lib" .dll)
		display=$(echo "$base" | sed 's/sotf_/SOTF /; s/_/ /g' | sed 's/\b\(.\)/\u\1/g')
		bundle="$VST3_DIR/${display}.vst3"
		mkdir -p "$bundle/Contents/x86_64-win"
		cp "$lib" "$bundle/Contents/x86_64-win/${base}.vst3"
	done
	echo "Bundled $(ls -d "$VST3_DIR"/*.vst3 | wc -l | tr -d ' ') VST3 plugins"

