# Install VST3 plugins on Windows (Common Files/VST3)
[group('install')]
install-vst3-windows: prod-vst3-windows
	#!/usr/bin/env bash
	set -euo pipefail
	DEST="C:/Program Files/Common Files/VST3"
	mkdir -p "$DEST"
	for bundle in dist/vst3-windows/*.vst3; do
		name=$(basename "$bundle")
		rm -rf "$DEST/$name"
		cp -R "$bundle" "$DEST/$name"
	done
	echo "Installed $(ls -d "$DEST"/SOTF*.vst3 2>/dev/null | wc -l | tr -d ' ') VST3 plugins to $DEST"

