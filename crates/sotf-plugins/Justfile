# ----------------------------------------------------------------------
# QA FUZZER
# ----------------------------------------------------------------------

[group('qa-plugins')]
qa-plugins-fuzzer: qa-plugins-fuzzer-simple qa-plugins-fuzzer-1ch qa-plugins-fuzzer-2ch qa-plugins-fuzzer-6ch

[group('qa-plugins')]
qa-plugins-fuzzer-simple:
	@qa_clang_cache_dir="${TMPDIR:-/tmp}/sotf-clang-module-cache"; \
	mkdir -p "$qa_clang_cache_dir"; \
	export CLANG_MODULE_CACHE_PATH="$qa_clang_cache_dir"; \
	for file in ./data_generated/test-audio/wav/pink_noise/pink_noise_*.wav; do \
		for plugin in gain eq compressor limiter gate delay loudness_monitor abcompare expander mbcomp mbexp matrix mutesolo denoiser spectrum pnd analog_eq analog_limiter analog_compressor; do \
			echo "=== Fuzzing plugin: $plugin with $file ==="; \
			{{cargo}} run --release --bin plugin-fuzzer -- --file "$file" --plugin $plugin || exit 1; \
		done; \
	done

[group('qa-plugins')]
qa-plugins-fuzzer-1ch:
	@qa_clang_cache_dir="${TMPDIR:-/tmp}/sotf-clang-module-cache"; \
	mkdir -p "$qa_clang_cache_dir"; \
	export CLANG_MODULE_CACHE_PATH="$qa_clang_cache_dir"; \
	for file in ./data_generated/test-audio/wav/pink_noise/pink_noise_ch1_*.wav; do \
		for plugin in mono_to_stereo; do \
			echo "=== Fuzzing plugin: $plugin with $file ==="; \
			{{cargo}} run --release --bin plugin-fuzzer -- --file "$file" --plugin $plugin || exit 1; \
		done; \
	done

