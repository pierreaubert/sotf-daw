# ----------------------------------------------------------------------
# TESTS
# ----------------------------------------------------------------------

# Run all plugin tests (lib + integration)
[group('plugins')]
plugins-test: plugins-test-lib plugins-test-integration plugins-test-host

# Library tests for all plugin crates
[group('plugins')]
plugins-test-lib:
	{{cargo}} test -p 'sotf-plugin-*' -p sotf-plugins --lib

# Integration and binary tests for every plugin crate, including new targets.
[group('plugins')]
plugins-test-integration:
	{{cargo}} test -p 'sotf-plugin-*' --tests

# Host infrastructure tests (DawHost, automation, STFT, etc.)
[group('plugins')]
plugins-test-host:
	{{cargo}} test -p sotf-host

# All facade integration suites, including the catalog-driven DSP matrix.
[group('plugins')]
plugins-test-suites:
	{{cargo}} test -p sotf-plugins --tests

# Run every plugin and host test target in one Cargo invocation.
[group('plugins')]
plugins-test-all:
	{{cargo}} test -p 'sotf-plugin-*' -p sotf-plugins -p sotf-host --lib --tests

